#!/usr/bin/env bash
#MISE description="Run hk fixers on files"
#USAGE arg "[files]" var=#true help="Specific files to fix (default: all files)"
#USAGE complete "files" type="file"

set -euo pipefail

# shellcheck disable=SC2154 # usage_files is set by mise from the #USAGE spec
eval "files=(${usage_files:-})"
# shellcheck disable=SC2154 # files is set by the eval above
if [ ${#files[@]} -gt 0 ]; then
  hk fix -- "${files[@]}"
else
  hk fix --all
fi
