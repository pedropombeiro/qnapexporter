#!/usr/bin/env bash
#MISE description="Run hk checks on files"
#USAGE arg "[files]" var=#true help="Specific files to lint (default: all files)"

set -euo pipefail

# shellcheck disable=SC2154 # usage_files is set by mise from the #USAGE spec
eval "files=(${usage_files:-})"
# shellcheck disable=SC2154 # files is set by the eval above
if [ ${#files[@]} -gt 0 ]; then
  hk check -- "${files[@]}"
else
  hk check --all
fi
